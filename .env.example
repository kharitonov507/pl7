# Скопируйте этот файл как .env.local и заполните данные приложения Xibo CMS.
# .env.local исключён из Git. Не отправляйте его вместе с исходниками и отчётами.
XIBO_BASE_URL=http://127.0.0.1:8088
XIBO_CLIENT_ID=
XIBO_CLIENT_SECRET=

# Опциональный общий токен лабораторного Go ingress.
DOOH_CMS_TOKEN=
